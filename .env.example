# Generate fresh keys in Argyle/NMI: Options > Security Keys
NMI_PRIVATE_KEY=replace_with_private_api_key
NMI_TOKENIZATION_KEY=replace_with_public_tokenization_key

# Production gateway. Use https://sandbox.nmi.com for a separate sandbox account.
NMI_BASE_URL=https://secure.nmi.com

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace_with_at_least_32_random_characters
PORT=5173
